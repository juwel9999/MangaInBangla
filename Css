* {
  box-sizing: border-box;
}

body {
  background: #111;
  color: #fff;
  font-family: system-ui, -apple-system, sans-serif;
  margin: 0;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.controls {
  padding: 12px;
  background: #1e1e1e;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
  align-items: center;
  border-bottom: 1px solid #2d2d2d;
}

select,
button {
  padding: 8px 12px;
  font-size: 15px;
  border-radius: 6px;
  border: 1px solid #444;
  background: #2b2b2b;
  color: #fff;
  cursor: pointer;
}

button:active {
  background: #3d3d3d;
}

.reader {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10px;
  touch-action: pan-y;
}

.reader img {
  max-width: 100%;
  max-height: 82vh;
  object-fit: contain;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}

.page-info {
  margin-top: 10px;
  font-size: 14px;
  color: #ccc;
}
